# ─────────────────────────────────────────────────────────────────────────────
# WebSentinel Frontend (Vite) — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Vite loads this file automatically on `vite` / `vite build` / `vite preview`.
# Only variables prefixed with VITE_ are exposed to client-side code.
# Do NOT commit this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dev server ───────────────────────────────────────────────────────────────
# Port the Vite dev server listens on.
PORT=5173

# Base path for the app (Replit routing convention). Use "/" for local dev.
BASE_PATH=/

# ── API connection ──────────────────────────────────────────────────────────
# URL of the WebSentinel API server. The frontend makes all API calls to
# {VITE_API_URL}/api/{endpoint}.
# Must match the PORT set in the API server's .env file.
VITE_API_URL=http://localhost:3000

# ── Replit-only (optional) ───────────────────────────────────────────────────
# When REPL_ID is set, Replit-specific Vite plugins are activated.
# Leave unset for local development.
# REPL_ID=
