# ─────────────────────────────────────────────────────────────────────────────
# WebSentinel Frontend (Vite) — Environment Configuration (Template)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env   (PowerShell)
# Only variables prefixed with VITE_ are exposed to client-side code.
# ─────────────────────────────────────────────────────────────────────────────

# Port the Vite dev server listens on.
PORT=5173

# Base path for the app (Replit routing convention). Use "/" for local dev.
BASE_PATH=/

# URL of the WebSentinel API server.
VITE_API_URL=http://localhost:3000

# Replit project ID (optional — activates Replit-specific Vite plugins).
# REPL_ID=
