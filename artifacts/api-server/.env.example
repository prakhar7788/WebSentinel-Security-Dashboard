# ─────────────────────────────────────────────────────────────────────────────
# WebSentinel API Server — Environment Configuration (Template)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env   (PowerShell)
# ─────────────────────────────────────────────────────────────────────────────

# Port the Express API server listens on.
PORT=3000

# Environment: "development" (pino-pretty logs) or "production" (JSON logs).
NODE_ENV=development

# Log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# JWT secret — used to sign and verify authentication tokens (HS256).
# REQUIRED. Must be at least 32 characters. Keep this secret and never commit it.
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# Database connection string (optional — prototype uses in-memory storage).
# Required only when connecting the @workspace/db Drizzle ORM layer.
# DATABASE_URL=postgresql://user:password@localhost:5432/websentinel

# Firebase / Firestore (optional — enables server-side persistence for users,
# sessions, and scan history). When all three FIREBASE_* vars are set, the API
# server uses Firestore instead of in-memory storage.
# Get credentials: Firebase Console → Project Settings → Service Accounts →
# Generate New Private Key, then copy the project ID, client email, and private key.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# VirusTotal API key (optional — enables the VirusTotal passive source).
# Get a free key at: https://www.virustotal.com/gui/join-us
# VT_API_KEY=your_virustotal_api_key_here
