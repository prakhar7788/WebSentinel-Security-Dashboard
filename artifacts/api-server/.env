# ─────────────────────────────────────────────────────────────────────────────
# WebSentinel API Server — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# This file is loaded automatically when using `node --env-file=.env`.
# Do NOT commit this file — it contains local config and optional secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express API server listens on.
PORT=3000

# Environment: "development" (pino-pretty logs) or "production" (JSON logs).
NODE_ENV=development

# Log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# ── API Routing ───────────────────────────────────────────────────────────────
# All routes are mounted under /api (configured in src/app.ts).
# The frontend calls {VITE_API_URL}/api/{endpoint} — e.g. http://localhost:3000/api/auth/login
#
# Available routes:
#   GET  /api/healthz                  — health check (no auth)
#   POST /api/auth/login               — login, returns { token, user }
#   POST /api/auth/logout              — logout, invalidates token
#   GET  /api/auth/me                   — current user (requires Bearer token)
#   POST /api/subdomains/enumerate     — subdomain enumeration (requires auth)
#   POST /api/tls/check                — TLS/certificate check (requires auth)

# ── Database (optional — prototype uses in-memory storage) ────────────────────
# Uncomment and set to enable PostgreSQL persistence via Drizzle ORM.
# The @workspace/db package (lib/db) requires this to connect.
# DATABASE_URL=postgresql://user:password@localhost:5432/websentinel

# ── Firebase / Firestore (optional — enables server-side persistence) ──────
# When all three FIREBASE_* vars are set, the API server stores users and
# scan history in Firestore. Without them, in-memory storage is used.
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=websentinel-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@websentinel-prod.iam.gserviceaccount.com
